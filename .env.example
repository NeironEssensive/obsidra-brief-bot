# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID: напишите боту /myid. Сюда приходят заявки, и только этот ID видит /leads и /stats
BOT_ADMIN_CHAT_ID=0
# Пароль базы — придумайте длинный случайный (или его сгенерирует tools/setup-local-db.ps1)
POSTGRES_PASSWORD=
# Прокси до api.telegram.org, если напрямую он недоступен: http://127.0.0.1:2080 или socks5://127.0.0.1:2080
BOT_PROXY=
